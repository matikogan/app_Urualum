rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === Pedidos entregados — histórico permanente para analytics ===
    match /pedidos_entregados/{id} {
      allow read:   if isAuthed();
      // Solo encargado (del mismo depósito), admin, o el operario asignado pueden registrar una entrega
      allow create: if isAuthed() && (
        (isEncargado() && request.resource.data.deposito == userDeposito()) ||
        (isOperario() && request.resource.data.operarioId == request.auth.uid) ||
        isAdmin()
      );
      // Ventas puede registrar/editar el pago (solo campos pago y pagoHistorial)
      // Admin puede hacer cualquier corrección
      allow update: if isAuthed() && (
        isAdmin() ||
        (isVentas() && request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['pago', 'pagoHistorial']))
      );
      allow delete: if isAuthed() && isAdmin();
    }

    // === Permitir mover pedidos despachados (nuevo histórico) ===
    match /pedidos_despachados/{id} {
      allow create: if request.auth != null && (userRole() == "ventas" || userRole() == "encargado");
      allow read:   if request.auth != null;

      // Encargado ISABELA marca entrega/control: solo puede tocar estos campos
      allow update: if request.auth != null && (
        // Encargado de ISABELA confirma control físico
        (isEncargado()
          && resource.data.deposito == userDeposito()
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['necesitaControl', 'controlFisicoAt', 'controladoPor']))
        ||
        // Admin puede hacer override del control (testing y correcciones)
        (isAdmin()
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['necesitaControl', 'controlFisicoAt', 'controladoPor', 'adminOverride']))
      );

      // Admin puede borrar (reset en testing)
      // Encargado puede borrar pedidos DESPACHADOS de su depósito (fallback de migración)
      // Operario asignado puede borrar al confirmar la entrega (control previo a entrega)
      allow delete: if request.auth != null && (
        isAdmin() ||
        (isEncargado() && resource.data.deposito == userDeposito()) ||
        (isOperario() && resource.data.operarioId == request.auth.uid)
      );
    }


    // =========================
    // Helpers de usuario
    // =========================
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAuthed() {
      return request.auth != null;
    }
    function userRole() {
      return userDoc().data.role;
    }
    function userDeposito() {
      return userDoc().data.deposito;
    }
    function isVentas() {
      return userRole() == "ventas";
    }
    function isEncargado() {
      return userRole() == "encargado";
    }
    function isOperario() {
      return userRole() == "operario";
    }

    // 🔥 ACÁ PONEMOS AL ADMIN PARA QUE TODOS LO VEAN
    function isAdmin() {
      return userRole() == "admin";
    }

    // =========================
    // users
    // =========================
    match /users/{uid} {
      
      // 1. Tu propio doc: PERMITIDO
      allow get: if isAuthed() && request.auth.uid == uid;

      // 2. Listar: Permitido para Staff (Encargado/Ventas)
      allow list: if isAuthed() && (isEncargado() || isVentas());

      // 3. Leer (Get/List):
      //    - Tu propio doc
      //    - O si sos del Staff (Ventas/Encargado/Admin) podés leer a cualquiera
      allow read: if isAuthed() && (
        request.auth.uid == uid ||
        isEncargado() ||
        isVentas()    ||
        isAdmin()
      );

      // Escritura: Solo el propio usuario puede editar sus datos (o crear su perfil)
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && request.auth.uid == uid;
      allow delete: if false;
    }


    // === CONFIG / FEATURE FLAGS ===
    match /config/{docId} {
      allow read: if isAuthed();
      // Admin puede escribir (ej: configurar rango de sync Finnegans)
      allow write: if isAuthed() && isAdmin();
    }


    // === Catálogo de productos ===
    match /catalogoProductos/{id} {
      // Todos los logueados pueden leer el catálogo
      allow read: if isAuthed();
      // Solo el administrador puede agregar o actualizar productos
      allow write: if isAuthed() && isAdmin();
    }

    // === Clientes Sincronizados ===
    match /clientes/{id} {
      // Cualquier empleado logueado puede buscar clientes
      allow read: if isAuthed();
      // Solo el administrador los puede sincronizar desde Finnegans
      allow write: if isAuthed() && isAdmin();
    }

    // === DIRECCIONES DE CLIENTES PARA ETIQUETAS ===
    // El encargado completa/edita dirección y localidad al imprimir etiquetas
    match /clientesDireccion/{clienteCodigo} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (isEncargado() || isAdmin());
    }

    // === CARGAS DE ETIQUETAS (camiones/giras) ===
    // El encargado crea cargas, agrega pedidos e imprime/controla la carga
    match /cargasEtiquetas/{cargaId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (isEncargado() || isAdmin());
    }

    // === REGLAS DE PRECIOS ===
    // Permitir leer a usuarios autenticados para calcular descuentos
    match /config_lista_precios/{id} {
      allow read: if isAuthed();
      allow write: if false; // Solo se edita desde la consola de Firebase
    }


    // === STOCK DE TIRAS SUELTAS ===
    match /stock_tiras/{codUru} {
      // Leer: cualquier usuario autenticado (puede ser útil para UI)
      allow read: if isAuthed();

      // Escribir: solo operario o encargado
      // Validamos que únicamente se escriba el campo "piezas", sea número, y no negativo.
      allow create, update: if (isOperario() || isEncargado())
        && request.resource.data.keys().hasOnly(['piezas'])
        && request.resource.data.piezas is number
        && request.resource.data.piezas >= 0;

      // No se borra desde cliente
      allow delete: if false;
    }

    // === MOVIMIENTOS DE STOCK DE TIRAS ===
    match /stock_tiras_mov/{movId} {
      // Leer: cualquier usuario autenticado (útil para auditorías en la UI)
      allow read: if isAuthed();

      // Crear: operario o encargado.
      // Validamos shape básico del movimiento.
      //  - ts: puede venir como serverTimestamp (no forzamos validación estricta)
      //  - codUru: string
      //  - tipo: 'consumo' | 'alta_remanente' | 'paquete_abierto'
      //  - delta: número (opcional en 'paquete_abierto', requerido en los otros)
      //  - pedidoId: string
      //  - usuarioId: debe ser el usuario que escribe
      allow create: if (isOperario() || isEncargado())
        && request.resource.data.codUru is string
        && request.resource.data.tipo in ['consumo', 'alta_remanente', 'paquete_abierto']
        && request.resource.data.pedidoId is string
        && request.resource.data.usuarioId == request.auth.uid
        && (
            // en 'consumo' y 'alta_remanente' esperamos delta numérico (negativo o positivo)
            ((request.resource.data.tipo in ['consumo','alta_remanente'])
              && request.resource.data.delta is number)
            ||
            // en 'paquete_abierto' permitimos que no haya delta y sí campos packSize/usadas/remanente
            (request.resource.data.tipo == 'paquete_abierto')
          );

      // No se editan ni borran movimientos desde cliente
      allow update, delete: if false;
    }

    match /paquetes_abiertos/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }


    // === CAMIONES (salidas programadas al interior) ===
    match /camiones/{id} {
      // Lectura: cualquier usuario autenticado (el sync la necesita sin importar el rol)
      allow read:   if isAuthed();
      // Gestión: solo encargado y admin
      allow create: if isAuthed() && (isEncargado() || isAdmin());
      allow update: if isAuthed() && (isEncargado() || isAdmin());
      allow delete: if isAuthed() && isAdmin();
    }

    match /pedidos/{id} {

      // --- SYNC ---
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.source == "finnegans";

      allow update: if request.auth != null
        && request.resource.data.source == "finnegans";

      allow delete: if request.auth != null && userRole() == "ventas";

      // --- OPERATIVOS UI ---

      function onlyOperationalFieldsChanged() {
        return request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(['estado', 'operarioId', 'operarioNombre', 'updatedAt', 'timestamps', 'errorDetalle', 'errorProductoCod', 'errorProductoNombre', 'errorProductos']);
      }

      function nuevoEstado() {
        return request.resource.data.estado;
      }

      // Encargado — estado / asignación operario
      function canEncargadoUpdate() {
        return isEncargado()
          && resource.data.deposito == userDeposito()
          && onlyOperationalFieldsChanged();
      }

      // Encargado — asignar / quitar camión
      function canEncargadoCamionUpdate() {
        return isEncargado()
          && resource.data.deposito == userDeposito()
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['camionId', 'metodoEntrega']);
      }

      // Operario
      function canOperarioUpdate() {
        return isOperario()
          && resource.data.operarioId == request.auth.uid
          && onlyOperationalFieldsChanged()
          && (
            nuevoEstado() == "EN_PREPARACION" ||
            nuevoEstado() == "PREPARADO"      ||
            // R8: operario puede reportar un error (encargado lo confirma antes de escalar a ventas)
            (nuevoEstado() == "CON_ERROR" && resource.data.deposito == "R8")
          );
      }

      // Ventas
      function canVentasUpdate() {
        return isVentas()
          && onlyOperationalFieldsChanged()
          && nuevoEstado() == "DESPACHADO";
      }

      // Ventas — guardar RUT del cliente
      function canVentasUpdateRUT() {
        return isVentas()
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['clienteRUT']);
      }

      // Admin — override completo de estado (incluye audit trail adminOverride)
      function canAdminOverride() {
        return isAdmin()
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['estado', 'operarioId', 'operarioNombre', 'updatedAt', 'timestamps',
                         'errorDetalle', 'errorProductoCod', 'errorProductoNombre', 'errorProductos',
                         'adminOverride', 'camionId', 'metodoEntrega', 'clienteRUT',
                         'cancelMotivo', 'canceladoPor', 'canceladoAt']);
      }

      // Ventas puede cancelar pedidos que NO estén ya despachados/entregados/cancelados
      function canVentasCancel() {
        return isVentas()
          && request.resource.data.estado == "CANCELADO"
          && !(resource.data.estado in ["DESPACHADO", "ENTREGADO", "CANCELADO", "ANULADO"])
          && request.resource.data.diff(resource.data).changedKeys()
               .hasOnly(['estado', 'cancelMotivo', 'canceladoPor', 'canceladoPorNombre',
                         'canceladoAt', 'canceladoDesdeEstado', 'updatedAt', 'timestamps']);
      }

      // **ÚNICO bloque operativo permitido**
      allow update: if isAuthed() && (
        canEncargadoUpdate()       ||
        canEncargadoCamionUpdate() ||
        canOperarioUpdate()        ||
        canVentasUpdate()          ||
        canVentasUpdateRUT()       ||
        canVentasCancel()          ||
        canAdminOverride()
      );

      // Ventas borra pedidos del flujo normal.
      // Encargado puede borrar pedidos DESPACHADOS de su depósito (fallback de migración:
      // cuando el pedido quedó en colección `pedidos` con estado=DESPACHADO en vez de
      // moverse a pedidos_despachados como corresponde).
      allow delete: if request.auth != null && (
        userRole() == "ventas" ||
        (isEncargado() && resource.data.estado == "DESPACHADO" && resource.data.deposito == userDeposito())
      );
    }



    match /errores_preparacion/{docId} {
    // Leer: encargado y ventas
    allow read: if isAuthed() && (isEncargado() || isVentas());

    // Crear: encargado (del depósito) u operario asignado al pedido
    allow create: if isAuthed() && (
      isEncargado() || isOperario()
    );
    // opcional: validar campos mínimos y tamaños; lo hacemos si querés después
    allow update, delete: if false;
  }



  




    // =========================
    // (Opcional) Bloque de prueba — dejar cerrado o eliminar
    // =========================
    match /test_read/{docId} {
      allow read: if isAuthed();   // si querés, ciérralo a false o bórralo
      allow write: if false;
    }

    // === ERRORES (NUEVO) ===
    // Solo encargado y ventas (según tus roles actuales)
    match /errorEvents/{docId} {
      allow read: if isAuthed() && (isEncargado() || isVentas());
      allow create: if isAuthed() && (isEncargado() || isVentas());
      allow update, delete: if false;
    }

    // === DESEMPEÑO DIARIO (NUEVO) ===
    // Encargado/ventas puede crear y leer.
    // (Si querés que SOLO el encargado pueda cargar, te lo ajusto después)
    match /dailyPerformance/{docId} {
      allow read: if isAuthed() && (isEncargado() || isVentas());
      allow create: if isAuthed() && (isEncargado() || isVentas());
      allow update: if isAuthed() && (isEncargado() || isVentas());
      allow delete: if false;
    }

    // === PEDIDOS WEB (CLIENTES E-COMMERCE) ===
    match /pedidos_web/{docId} {
      // Cualquier usuario logueado puede crear su pedido
      allow create: if isAuthed();
      // Ventas, Encargados, o el propio cliente pueden leer y actualizar.
      // Un cliente puede leer su pedido si:
      //   a) clienteId coincide con su UID (pedido creado por el mismo cliente), O
      //   b) clienteFinnegansId coincide con su código en el perfil (pedido creado por un vendedor en su nombre)
      allow read, update: if isAuthed() && (
        isVentas() ||
        isEncargado() ||
        resource.data.clienteId == request.auth.uid ||
        resource.data.clienteFinnegansId == userDoc().data.finnegansClienteCodigo
      );
      allow delete: if false;
    }



    // Por defecto, denegar todo lo no especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
